// Cover of the SciPy paper news post: a simplified version of benchmarks/python-bindings/figures/architecture.dot in
// humemai/arcadedb-embedded-python (the API box, the JVM box and the sub-labels are dropped so the type can be large).
// Build: see "Diagram covers" in docs/design/image-generation.md.
digraph arch {
  rankdir=TB; bgcolor="#faf8f5"; dpi=170;
  graph [fontname="Helvetica", margin=0, pad="0.05", ranksep="0.75", nodesep="0.6"];
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=44,
        fillcolor="#eef3fb", color="#33557a", penwidth=2.4, margin="0.42,0.26"];
  edge [color="#33557a", penwidth=3.2, arrowsize=1.1];

  subgraph cluster_py {
    label="Python process"; labeljust=l; style="rounded,dashed"; color="#888888";
    fontname="Helvetica"; fontsize=44; margin=44; penwidth=2.4;

    code [label="your Python code", fillcolor="#f6f6f6", color="#888888"];
    eng  [label="ArcadeDB engine", fillcolor="#e6edfb"];
    doc  [label="Documents", fillcolor="#eafbea", color="#2e7d32"];
    gr   [label="Graph", fillcolor="#eafbea", color="#2e7d32"];
    vec  [label="Vectors", fillcolor="#eafbea", color="#2e7d32"];
  }

  code -> eng;
  eng -> doc; eng -> gr; eng -> vec;
}
